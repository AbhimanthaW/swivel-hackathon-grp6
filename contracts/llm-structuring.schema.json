{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:muthuwella:llm-structuring:v1",
  "title": "LLMStructuringResult",
  "description": "Backend-internal candidate structure; all references and claims must be validated before publication.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string"
          },
          "sourceReportIds": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "workType": {
            "type": "string"
          },
          "location": {
            "anyOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "label": {
                    "type": "string",
                    "minLength": 1
                  },
                  "assetIds": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "reason": {
                    "type": "string"
                  }
                },
                "required": [
                  "label",
                  "assetIds",
                  "reason"
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "groupingReason": {
            "type": "string"
          },
          "confidence": {
            "description": "Model confidence in this candidate grouping, or null when no meaningful measure is available. Never invented, and never authoritative for prioritization or dispatch.",
            "anyOf": [
              {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              {
                "type": "null"
              }
            ]
          },
          "uncertainties": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "riskSignals": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "label": {
                  "type": "string"
                },
                "evidenceReportIds": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "reason": {
                  "type": "string"
                }
              },
              "required": [
                "label",
                "evidenceReportIds",
                "reason"
              ]
            }
          }
        },
        "required": [
          "title",
          "description",
          "sourceReportIds",
          "workType",
          "location",
          "groupingReason",
          "confidence",
          "uncertainties",
          "riskSignals"
        ]
      }
    }
  },
  "required": [
    "candidates"
  ]
}
